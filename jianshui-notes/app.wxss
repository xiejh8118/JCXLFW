/* 全局样式 - 柬税笔记 */

/* ===== TDesign 主题变量覆盖 ===== */
page {
  /* 品牌色 - 柬埔寨金色 */
  --td-brand-color: #C8963E;
  --td-brand-color-light: #F5E6CC;
  --td-brand-color-active: #A67A2E;
  --td-brand-color-disabled: #E0D0B0;
  
  /* 主色调 */
  --td-primary-color: #C8963E;
  --td-primary-color-hover: #D4A84E;
  --td-primary-color-active: #A67A2E;
  
  /* 圆角 */
  --td-radius-default: 12rpx;
  --td-radius-medium: 16rpx;
  --td-radius-large: 24rpx;
  
  /* 背景色 */
  --td-bg-color-page: #F8F5F0;
  --td-bg-color-container: #FFFFFF;
  
  /* 文字色 */
  --td-text-color-primary: #2C2416;
  --td-text-color-secondary: #8B7355;
  --td-text-color-placeholder: #BFB09A;
  
  /* 字体 */
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: #2C2416;
  background-color: #F8F5F0;
  box-sizing: border-box;
}

/* ===== 通用样式 ===== */

/* 页面容器 */
.page-container {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 卡片 */
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2C2416;
  margin-bottom: 16rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #8B7355;
  line-height: 1.6;
}

/* 区块标题 */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 24rpx 16rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2C2416;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: #C8963E;
  border-radius: 3rpx;
}

.section-more {
  font-size: 26rpx;
  color: #C8963E;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.tag-primary {
  background: #F5E6CC;
  color: #C8963E;
}

.tag-secondary {
  background: #F0F0F0;
  color: #8B7355;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-state-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

.empty-state-text {
  font-size: 28rpx;
  color: #BFB09A;
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background: #F0EDE6;
  margin: 24rpx 0;
}

/* 弹性布局 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

/* 间距 */
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.p-24 { padding: 24rpx; }
.p-32 { padding: 32rpx; }

/* 文字 */
.text-center { text-align: center; }
.text-primary { color: #C8963E; }
.text-secondary { color: #8B7355; }
.text-small { font-size: 24rpx; }
.text-large { font-size: 36rpx; }
.font-bold { font-weight: 700; }
