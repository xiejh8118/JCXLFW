/* 首页样式 */

/* 轮播图 */
.banner-wrapper {
  margin: 24rpx;
}

.banner-swiper {
  height: 320rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.banner-card {
  height: 100%;
  padding: 40rpx;
  display: flex;
  align-items: center;
  border-radius: 24rpx;
}

.banner-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.banner-text {
  flex: 1;
}

.banner-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}

.banner-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.banner-icon {
  font-size: 96rpx;
  margin-left: 24rpx;
}

/* 快捷入口 */
.entry-section {
  padding: 16rpx 24rpx;
}

.entry-grid {
  display: flex;
  flex-wrap: wrap;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.entry-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.entry-icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.entry-icon {
  font-size: 40rpx;
}

.entry-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2C2416;
  margin-bottom: 4rpx;
}

.entry-desc {
  font-size: 20rpx;
  color: #BFB09A;
}

/* 热门景点 */
.spot-list {
  padding: 0 24rpx;
}

.spot-card {
  margin: 0 0 24rpx 0;
}

.spot-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.spot-icon {
  font-size: 64rpx;
  margin-right: 20rpx;
}

.spot-info {
  flex: 1;
}

.spot-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C2416;
  margin-bottom: 6rpx;
}

.spot-location {
  font-size: 24rpx;
  color: #8B7355;
  margin-bottom: 6rpx;
}

.spot-rating {
  display: flex;
}

.star {
  font-size: 28rpx;
  color: #E0D0B0;
  margin-right: 4rpx;
}

.star.active {
  color: #F5A623;
}

.spot-desc {
  font-size: 26rpx;
  color: #8B7355;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.spot-tags {
  display: flex;
  flex-wrap: wrap;
}

/* 精选特产 */
.specialty-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx;
}

.specialty-card {
  width: calc(50% - 36rpx);
  margin: 0 12rpx 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 32rpx 16rpx;
}

.specialty-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.specialty-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2416;
  margin-bottom: 8rpx;
}

.specialty-price {
  font-size: 24rpx;
  color: #C8963E;
  margin-bottom: 6rpx;
}

.specialty-rating {
  display: flex;
}

.star-small {
  font-size: 22rpx;
  color: #E0D0B0;
  margin-right: 2rpx;
}

.star-small.active {
  color: #F5A623;
}

/* 底部 */
.footer-tip {
  text-align: center;
  padding: 40rpx 0 60rpx;
}
