/* 柬埔寨问答页面 */

.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F8F5F0;
}

/* 聊天滚动区域 */
.chat-scroll {
  flex: 1;
  padding-bottom: 20rpx;
}

.chat-messages {
  padding: 24rpx;
}

/* 消息行 */
.msg-wrapper {
  margin-bottom: 28rpx;
}

.msg-row-assistant {
  display: flex;
  align-items: flex-start;
}

.msg-row-user {
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
}

/* 头像 */
.avatar-assistant,
.avatar-user {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.avatar-assistant {
  background: linear-gradient(135deg, #C8963E, #D4A84E);
  margin-right: 16rpx;
}

.avatar-user {
  background: linear-gradient(135deg, #5BA0D0, #6BB5E0);
  margin-left: 16rpx;
}

/* 消息气泡 */
.msg-bubble-assistant {
  max-width: 75%;
  background: #FFFFFF;
  border-radius: 4rpx 20rpx 20rpx 20rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.msg-bubble-user {
  max-width: 75%;
  background: #C8963E;
  border-radius: 20rpx 4rpx 20rpx 20rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(200, 150, 62, 0.2);
}

.msg-bubble-user .msg-text {
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-line;
}

.msg-bubble-assistant .msg-text {
  color: #2C2416;
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-line;
}

.msg-time {
  font-size: 20rpx;
  color: #BFB09A;
  text-align: right;
  margin-top: 8rpx;
}

.msg-bubble-user .msg-time {
  color: rgba(255, 255, 255, 0.6);
}

/* 打字动画 */
.typing-bubble {
  padding: 24rpx 32rpx;
}

.typing-dots {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #BFB09A;
  animation: typingBounce 1.4s ease-in-out infinite;
}

.dot:nth-child(1) { animation-delay: 0s; }
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typingBounce {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  30% {
    transform: translateY(-12rpx);
    opacity: 1;
  }
}

/* 快捷问题区域 */
.quick-section {
  margin-top: 32rpx;
  padding: 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.quick-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2416;
  margin-bottom: 20rpx;
}

.quick-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.quick-item {
  padding: 14rpx 24rpx;
  background: #F5E6CC;
  color: #C8963E;
  border-radius: 40rpx;
  font-size: 26rpx;
  border: 1rpx solid rgba(200, 150, 62, 0.2);
  transition: all 0.2s;
}

.quick-item:active {
  background: #C8963E;
  color: #FFFFFF;
}

/* 底部输入区域 */
.input-area {
  background: #FFFFFF;
  border-top: 1rpx solid #F0EDE6;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background: #F8F5F0;
  border-radius: 40rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #2C2416;
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #E0D0B0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.send-btn.active {
  background: #C8963E;
}

.send-icon {
  font-size: 28rpx;
  color: #FFFFFF;
}

/* 快捷问题栏（底部小条） */
.mini-quick-bar {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding-bottom: 4rpx;
}

.mini-quick-label {
  font-size: 22rpx;
  color: #BFB09A;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.mini-quick-item {
  font-size: 22rpx;
  color: #C8963E;
  padding: 6rpx 16rpx;
  background: #F5E6CC;
  border-radius: 20rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}
