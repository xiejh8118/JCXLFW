# ===== 微信小程序 =====
# 现有小程序 appid（海外主体）
APPID=wx05aeb867e67c8f9c
# 小程序 AppSecret（微信公众平台 -> 开发 -> 开发设置）。留空则进入本地开发模式（code 直接当 openid）
APPSECRET=

# ===== 服务端口 =====
PORT=3000

# ===== AI 助手（微信AI生态 / 大模型，OpenAI 兼容网关）=====
# 接入微信AI生态：将下方 base url / key / model 替换为微信AI或元宝提供的网关凭证
# 留空则启用规则降级模式（离线可演示）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-3.5-turbo

# 默认应答语言 zh-CN | en | km
DEFAULT_LANG=zh-CN
