/* app.wxss - 全局样式 */

/* ========== CSS 变量（米白+香槟金轻奢商务风） ========== */
page {
  --primary: #3A342E;           /* 一级标题/主文字 - 暖深棕 */
  --primary-light: #59524A;     /* 二级正文 */
  --primary-dark: #9E6F53;      /* 辅助强调棕红，只做点缀 */
  --accent: #C8A878;            /* 香槟金 - 主按钮/图标/强调 */
  --accent-light: #E8D9C3;      /* 香槟金浅 - 边框/弱强调 */
  --gold: #C8A878;              /* 品牌香槟金 */
  --gold-light: #F7EFE3;        /* 极浅香槟底 */
  --success: #27AE60;           /* 热带绿 */
  --danger: #E74C3C;            /* 警示红 */
  --warning: #F39C12;           /* 警告黄 */
  --info: #9E6F53;              /* 信息棕红 */

  --bg-primary: #F8F5F0;        /* 暖米白页面底色 */
  --bg-card: #FFFFFF;           /* 纯白卡片 */
  --bg-secondary: #F7EFE3;      /* 极浅香槟辅助底 */

  --text-primary: #3A342E;      /* 一级标题 */
  --text-secondary: #59524A;    /* 二级正文 */
  --text-hint: #8C8276;         /* 辅助小字 */

  --border-color: #E8D9C3;
  --shadow: 0 4rpx 12rpx rgba(120, 95, 65, 0.08);

  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;

  /* 圆润优先：苹方/鸿蒙圆体在前，避免 Helvetica/SF 硬朗字形 */
  --font-family: 'PingFang SC', 'HarmonyOS Sans SC', 'Source Han Sans SC',
    'Microsoft YaHei', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;

  font-family: var(--font-family);
  font-size: 28rpx;
  color: var(--text-primary);
  background-color: var(--bg-primary);
  line-height: 1.6;
  box-sizing: border-box;
}

/* ========== 通用布局 ========== */
.container {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.page-header {
  padding: 32rpx 30rpx 24rpx;
  background: linear-gradient(135deg, #F8F5F0, #F3EBDF);
}

.page-header__title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.page-header__subtitle {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
}

.section {
  margin: 24rpx 30rpx;
}

.section__title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid var(--gold);
}

/* ========== 卡片 ========== */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card--hover {
  transition: transform 0.2s, box-shadow 0.2s;
}

.card--hover:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 8rpx rgba(184, 134, 11, 0.12);
}

/* ========== 按钮 ========== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 40rpx;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  transition: opacity 0.2s;
}

.btn:active {
  opacity: 0.8;
}

.btn--primary {
  background: linear-gradient(135deg, var(--gold), var(--accent-light));
  color: #FFFFFF;
}

.btn--outline {
  background: transparent;
  color: var(--gold);
  border: 2rpx solid var(--gold);
}

.btn--accent {
  background: linear-gradient(135deg, var(--accent-light), var(--gold-light));
  color: var(--text-primary);
}

.btn--sm {
  height: 56rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  border-radius: var(--radius-sm);
}

.btn--lg {
  height: 96rpx;
  padding: 0 56rpx;
  font-size: 32rpx;
  border-radius: var(--radius-lg);
}

.btn--block {
  display: flex;
  width: 100%;
}

/* ========== 表单 ========== */
.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--bg-secondary);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  color: var(--text-primary);
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: var(--gold);
  background: var(--bg-card);
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  background: var(--bg-secondary);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  color: var(--text-primary);
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

/* ========== 标签/徽章 ========== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  line-height: 1.6;
}

.tag--primary {
  background: rgba(200, 168, 120, 0.12);
  color: var(--gold);
}

.tag--success {
  background: rgba(39, 174, 96, 0.1);
  color: var(--success);
}

.tag--danger {
  background: rgba(231, 76, 60, 0.1);
  color: var(--danger);
}

.tag--warning {
  background: rgba(243, 156, 18, 0.1);
  color: var(--warning);
}

/* ========== 工具类 ========== */
.flex { display: flex; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-wrap { flex-wrap: wrap; }
.flex-1 { flex: 1; }
.flex-col { display: flex; flex-direction: column; }

.text-center { text-align: center; }
.text-right { text-align: right; }
.text-primary { color: var(--primary); }
.text-accent { color: var(--accent); }
.text-success { color: var(--success); }
.text-danger { color: var(--danger); }
.text-hint { color: var(--text-hint); }

.text-sm { font-size: 22rpx; }
.text-md { font-size: 28rpx; }
.text-lg { font-size: 36rpx; }
.text-xl { font-size: 44rpx; }

.fw-bold { font-weight: 700; }

.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.ml-10 { margin-left: 10rpx; }
.mr-10 { margin-right: 10rpx; }

.p-20 { padding: 20rpx; }
.p-30 { padding: 30rpx; }

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.empty-state__icon {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.3;
  margin-bottom: 24rpx;
}

.empty-state__text {
  font-size: 28rpx;
  color: var(--text-hint);
}

/* ========== 加载态 ========== */
.loading-more {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: var(--text-hint);
}

/* ========== 分隔线 ========== */
.divider {
  height: 1rpx;
  background: var(--border-color);
  margin: 20rpx 0;
}

/* ========== 价格显示 ========== */
.price {
  color: var(--accent);
  font-weight: 700;
}

.price--usd::before { content: '$ '; }
.price--khr::after { content: ' ៛'; }
.price--rmb::before { content: '¥ '; }
