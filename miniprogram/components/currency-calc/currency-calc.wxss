/* components/currency-calc/currency-calc.wxss */

.currency-calc {
  margin-bottom: 0;
}

.currency-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.currency-selector {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.currency-chip {
  padding: 8rpx 16rpx;
  background: var(--bg-secondary);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  transition: all 0.2s;
}

.currency-chip--active {
  background: var(--primary);
  color: #FFFFFF;
  font-weight: 600;
}

.currency-input {
  flex: 1;
  text-align: right;
  padding: 12rpx 16rpx;
  background: var(--bg-secondary);
  border-radius: var(--radius-sm);
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  min-width: 120rpx;
}

.currency-input--result {
  background: rgba(184, 134, 11, 0.05);
  color: var(--primary);
}

.swap-btn {
  display: flex;
  justify-content: center;
  padding: 8rpx 0;
}

.swap-btn text {
  width: 48rpx;
  height: 48rpx;
  background: var(--bg-secondary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--primary);
}

.quick-chip {
  padding: 6rpx 16rpx;
  background: rgba(184, 134, 11, 0.06);
  border-radius: 16rpx;
  font-size: 22rpx;
  color: var(--primary);
  margin-right: 10rpx;
  margin-bottom: 8rpx;
}

.quick-chip:active {
  background: var(--primary);
  color: #FFFFFF;
}
