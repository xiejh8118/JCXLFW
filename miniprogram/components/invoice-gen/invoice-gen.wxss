/* components/invoice-gen/invoice-gen.wxss */

.invoice-modal {
  width: 100%;
  max-height: 85vh;
  background: var(--bg-card);
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}

.invoice-header {
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid var(--border-color);
  flex-shrink: 0;
}

.invoice-body {
  flex: 1;
  padding: 24rpx 30rpx;
  overflow-y: auto;
}

.invoice-section {
  margin-bottom: 30rpx;
}

.invoice-section__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 16rpx;
  padding-bottom: 8rpx;
  border-bottom: 2rpx solid var(--primary);
}

.info-row {
  padding: 12rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx dashed var(--border-color);
}
