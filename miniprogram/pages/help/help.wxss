/* pages/help/help.wxss - AI 智能助手聊天界面 */
.container { display: flex; flex-direction: column; height: 100vh; box-sizing: border-box; background: var(--bg-primary); }
.help-header { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 30rpx 16rpx; }
.help-title { font-size: 34rpx; font-weight: 700; color: var(--text-primary); }
.help-lang { padding: 6rpx 20rpx; background: #fff; border: 2rpx solid var(--border-color); border-radius: 30rpx; font-size: 22rpx; color: var(--text-secondary); }

/* AI 中枢内置能力：智能派单快捷条 */
.hub-quick { margin: 0 24rpx 16rpx; }
.hub-quick__chip {
  display: flex;
  align-items: center;
  padding: 22rpx 26rpx;
  background: #FFFFFF;
  border: 1rpx solid #E8D9C3;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(120, 95, 65, 0.08);
}
.hub-quick__chip:active { transform: scale(0.98); }
.hub-quick__icon { font-size: 40rpx; margin-right: 20rpx; }
.hub-quick__body { flex: 1; }
.hub-quick__title { font-size: 28rpx; font-weight: 700; color: var(--text-primary); margin-bottom: 4rpx; }
.hub-quick__desc { font-size: 22rpx; color: var(--text-hint); }
.hub-quick__arrow { font-size: 40rpx; color: var(--gold); margin-left: 12rpx; }

.chat { flex: 1; padding: 0 24rpx; box-sizing: border-box; }

.chat-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 100rpx 40rpx; }
.chat-empty__icon { font-size: 90rpx; margin-bottom: 24rpx; }
.chat-empty__text { font-size: 26rpx; color: var(--text-hint); text-align: center; line-height: 1.6; }

.bubble-row { display: flex; align-items: flex-end; margin-bottom: 24rpx; }
.bubble-row.user { flex-direction: row-reverse; }
.avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: #fff; display: flex; align-items: center; justify-content: center; font-size: 34rpx; margin-right: 16rpx; box-shadow: var(--shadow); }
.bubble { max-width: 78%; padding: 20rpx 24rpx; border-radius: 20rpx; font-size: 28rpx; line-height: 1.6; word-break: break-word; }
.bubble.assistant { background: #fff; color: var(--text-primary); border-top-left-radius: 4rpx; box-shadow: var(--shadow); }
.bubble.user { background: linear-gradient(135deg, var(--gold), var(--accent-light)); color: #fff; border-top-right-radius: 4rpx; }
.bubble.loading { opacity: 0.7; }

.faq-bar { padding: 12rpx 24rpx; background: var(--bg-primary); border-top: 2rpx solid var(--border-color); }
.faq-scroll { white-space: nowrap; }
.faq-chip { display: inline-block; padding: 12rpx 24rpx; margin-right: 16rpx; background: #fff; border: 2rpx solid var(--border-color); border-radius: 30rpx; font-size: 24rpx; color: var(--text-secondary); }

.input-bar { display: flex; align-items: center; padding: 16rpx 24rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 2rpx solid var(--border-color); }
.input { flex: 1; height: 72rpx; padding: 0 24rpx; background: var(--bg-secondary); border-radius: 36rpx; font-size: 28rpx; }
.send-btn { margin-left: 16rpx; height: 72rpx; line-height: 72rpx; padding: 0 36rpx; background: linear-gradient(135deg, var(--gold), var(--accent-light)); color: #fff; border-radius: 36rpx; font-size: 28rpx; }
.send-btn::after { border: none; }
