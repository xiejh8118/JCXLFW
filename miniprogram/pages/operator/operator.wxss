/* pages/operator/operator.wxss */
.page {
  min-height: 100vh;
  background: var(--bg-primary);
  box-sizing: border-box;
}

.login-card {
  margin: 60rpx 30rpx;
  padding: 60rpx 40rpx;
  background: #fff;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
  border: 1rpx solid var(--border-color);
}

.login-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  text-align: center;
}

.login-hint {
  font-size: 24rpx;
  color: var(--text-hint);
  text-align: center;
  margin-bottom: 50rpx;
  line-height: 1.5;
}

.login-input {
  width: 100%;
  height: 96rpx;
  padding: 0 28rpx;
  margin-bottom: 40rpx;
  background: var(--bg-secondary);
  border-radius: var(--radius-md);
  font-size: 30rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.login-input:focus {
  border-color: var(--gold);
  background: #fff;
}

.btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: var(--radius-md);
  font-size: 32rpx;
  font-weight: 600;
  margin: 0;
  padding: 0;
  text-align: center;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, var(--gold) 0%, var(--accent-light) 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(120, 95, 65, 0.25);
}

.btn-primary:active {
  opacity: 0.9;
  transform: translateY(2rpx);
}

.tip-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx;
  background: linear-gradient(135deg, #F8F5F0 0%, #F3EBDF 100%);
  color: var(--text-primary);
  box-shadow: 0 4rpx 12rpx rgba(120, 95, 65, 0.08);
}

.tip-bar__title {
  font-size: 28rpx;
  font-weight: 600;
}

.tip-bar__logout {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 8rpx 20rpx;
  background: rgba(200, 168, 120, 0.16);
  border-radius: 30rpx;
}

.workflow-hint {
  margin: 24rpx 30rpx 16rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
}

.workflow-hint__title {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-bottom: 18rpx;
}

.workflow-steps {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.workflow-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.workflow-step__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-bottom: 8rpx;
}

.workflow-step__text {
  font-size: 20rpx;
  color: var(--text-secondary);
  text-align: center;
}

.workflow-step__arrow {
  font-size: 24rpx;
  color: var(--text-hint);
  padding: 0 8rpx;
  flex-shrink: 0;
}

.req-list {
  height: calc(100vh - 90rpx);
  padding: 20rpx 30rpx 40rpx;
  box-sizing: border-box;
}

.req-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

.req-card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.req-card__no {
  font-size: 24rpx;
  color: var(--text-hint);
  font-weight: 500;
}

.req-card__status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.status--pending { color: #ef6c00; background: #fff3e0; }
.status--matching { color: #1565c0; background: #e3f2fd; }
.status--accepted { color: var(--gold); background: rgba(200, 168, 120, 0.12); }
.status--processing { color: #6a1b9a; background: #f3e5f5; }
.status--completed { color: var(--success); background: #e8f5e9; }
.status--rated { color: var(--text-hint); background: var(--bg-secondary); }

.req-card__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.req-card__meta {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.req-card__detail {
  font-size: 26rpx;
  color: var(--text-primary);
  background: var(--bg-secondary);
  border-radius: 10rpx;
  padding: 16rpx;
  margin: 16rpx 0;
}

.req-card__actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--border-color);
}

.action-btn {
  min-width: 200rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 38rpx;
  margin: 0;
  padding: 0 36rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.action-btn::after {
  border: none;
}

.action-btn--primary {
  background: linear-gradient(135deg, var(--gold) 0%, var(--accent-light) 100%);
  color: #fff;
  box-shadow: 0 6rpx 18rpx rgba(120, 95, 65, 0.22);
}

.action-btn--primary:active {
  opacity: 0.9;
}

.action-btn--success {
  background: linear-gradient(135deg, var(--success) 0%, #2ecc71 100%);
  color: #fff;
  box-shadow: 0 6rpx 18rpx rgba(39, 174, 96, 0.3);
}

.action-btn--success:active {
  opacity: 0.9;
}

.done-badge {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  background: var(--bg-secondary);
  color: var(--text-hint);
  font-size: 26rpx;
  font-weight: 500;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  color: var(--text-hint);
}

.empty__icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty__text {
  font-size: 28rpx;
}

/* 模块筛选 */
.filter-bar {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 30rpx 4rpx;
  flex-wrap: wrap;
}
.filter-chip {
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  background: #fff;
  color: var(--text-secondary);
  border: 1rpx solid var(--border-color);
}
.filter-chip.active {
  background: var(--gold);
  color: #fff;
  border-color: var(--gold);
}

/* 超时高亮 */
.req-card--overdue {
  border: 2rpx solid #d32f2f;
  box-shadow: 0 4rpx 16rpx rgba(211, 47, 47, 0.18);
}
.req-card__module {
  font-size: 22rpx;
  color: #fff;
  background: linear-gradient(135deg, var(--gold) 0%, var(--accent-light) 100%);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-right: 8rpx;
}
.req-card__overdue {
  font-size: 22rpx;
  color: #d32f2f;
  margin-top: 8rpx;
}

.action-btn--warn {
  background: linear-gradient(135deg, #b71c1c 0%, #e57373 100%);
  color: #fff;
  box-shadow: 0 6rpx 18rpx rgba(183, 28, 28, 0.3);
}
.action-btn--warn:active { opacity: 0.9; }

.action-btn--ghost {
  background: #fff;
  color: var(--primary);
  border: 1rpx solid var(--gold);
}
.action-btn--ghost:active { background: var(--bg-secondary); }

/* 已录入信息展示 */
.req-card__entry {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  background: linear-gradient(160deg, #F7EFE3, #FDFBF7);
  border-radius: 12rpx;
  border: 1rpx solid #E8D9C3;
}
.req-card__entry-row {
  display: flex;
  align-items: flex-start;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}
.req-card__entry-row:last-child { margin-bottom: 0; }
.req-card__entry-label {
  flex-shrink: 0;
  color: var(--gold);
  font-weight: 600;
  margin-right: 14rpx;
  position: relative;
  padding-left: 18rpx;
}
.req-card__entry-label::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--gold);
}
.req-card__entry-val {
  flex: 1;
  color: var(--text-primary);
  line-height: 1.5;
}

/* 录入弹窗 */
.entry-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.entry-panel {
  width: 600rpx;
  max-height: 86vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 24rpx;
  padding: 44rpx 40rpx 36rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.25);
}
.entry-panel__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 32rpx;
}
.entry-field {
  margin-bottom: 28rpx;
}
.entry-field__label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}
.entry-field__input {
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: var(--bg-secondary);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--text-primary);
  border: 1rpx solid transparent;
}
.entry-field__input:focus { border-color: var(--gold); background: #fff; }
.entry-field__textarea {
  width: 100%;
  min-height: 140rpx;
  padding: 18rpx 24rpx;
  box-sizing: border-box;
  background: var(--bg-secondary);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--text-primary);
  border: 1rpx solid transparent;
}
.entry-field__textarea:focus { border-color: var(--gold); background: #fff; }
.entry-panel__actions {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
}
.btn-entry {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin: 0;
  padding: 0;
  text-align: center;
}
.btn-entry::after { border: none; }
.btn-entry--cancel {
  background: var(--bg-secondary);
  color: var(--text-secondary);
}
.btn-entry--save {
  background: linear-gradient(135deg, var(--gold) 0%, var(--accent-light) 100%);
  color: #fff;
  box-shadow: 0 6rpx 18rpx rgba(120, 95, 65, 0.22);
}
.btn-entry--cancel:active { opacity: 0.85; }
.btn-entry--save:active { opacity: 0.9; }

.status--returned { color: #b71c1c; background: #fdecea; }

.tip-bar__overdue { font-size: 26rpx; color: #ffd54f; font-weight: 600; }

/* ============ 顶部 Tab（需求单 / 房态）============ */
.tab-bar {
  display: flex;
  margin: 20rpx 30rpx 4rpx;
  background: var(--bg-secondary);
  border-radius: var(--radius-md);
  padding: 6rpx;
}
.tab-bar__item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
  border-radius: var(--radius-sm);
  transition: all .2s;
}
.tab-bar__item.active {
  background: #fff;
  color: var(--gold);
  font-weight: 600;
  box-shadow: var(--shadow);
}

/* ============ 房态卡片（住宿闭环）============ */
.room-card {
  margin: 18rpx 30rpx;
  padding: 26rpx 28rpx;
  background: #fff;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
  border: 1rpx solid var(--border-color);
  border-left: 6rpx solid var(--gold);
}
.room-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.room-card__no {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.room-card__status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}
.room-card__meta {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 6rpx;
  line-height: 1.5;
}
.room-card__pay {
  margin: 12rpx 0;
  padding: 14rpx 18rpx;
  background: linear-gradient(160deg, #F9EED6, #FCF6EA);
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(200, 168, 120, 0.2);
  font-size: 24rpx;
  color: var(--text-primary);
  line-height: 1.5;
}
.room-card__pay-label { font-weight: 600; color: var(--gold); }
.room-card__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

/* 房态色标 */
.status--reserved { color: #1565c0; background: #e3f2fd; }
.status--checked_in { color: var(--success); background: #e8f5e9; }
.status--checked_out { color: var(--text-hint); background: var(--bg-secondary); }

.tip-bar__income { color: var(--gold); font-weight: 600; }
