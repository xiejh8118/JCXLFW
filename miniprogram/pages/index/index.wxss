/* pages/index/index.wxss - 红金重工商务风 */

.index-header {
  position: relative;
  padding: 48rpx 30rpx 40rpx;
  background: linear-gradient(90deg, #F8F5F0 0%, #F3EBDF 100%);
  color: var(--text-primary);
  border-radius: 0 0 44rpx 44rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(120, 95, 65, 0.08);
}

/* 顶部装饰网格（香槟金低透明度，不抢文字） */
.index-header__bg-pattern {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(200, 168, 120, 0.04) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(200, 168, 120, 0.04) 1rpx, transparent 1rpx);
  background-size: 40rpx 40rpx;
  pointer-events: none;
}

/* 底部香槟金细线 */
.index-header::after {
  content: '';
  position: absolute;
  left: 10%;
  right: 10%;
  bottom: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, #C8A878 30%, #E8D9C3 70%, transparent 100%);
  border-radius: 2rpx;
  opacity: 0.7;
}

.index-header__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  z-index: 1;
}

.index-header__brand {
  display: flex;
  align-items: center;
}

.index-header__logo {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background: transparent;
  padding: 0;
  box-sizing: border-box;
  /* 轻微半透明 + 浮起阴影，让深蓝 LOGO 与深红页面有融合感而不"贴膏药" */
  opacity: 0.9;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
}

.index-header__text {
  display: flex;
  flex-direction: column;
}

.index-header__greeting {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-bottom: 4rpx;
  letter-spacing: 1rpx;
}

.index-header__title {
  font-size: 38rpx;
  font-weight: 500;
  letter-spacing: 3rpx;
  line-height: 1.25;
  color: var(--text-primary);
}

.index-header__subtitle {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

/* ===== AI 智能服务中枢 ===== */
.ai-hub {
  position: relative;
  margin: 6rpx 0;
  background: #FFFFFF;
  border-radius: 28rpx;
  border: 1rpx solid #E8D9C3;
  box-shadow: 0 8rpx 28rpx rgba(120, 95, 65, 0.08);
  overflow: hidden;
}

.ai-hub:active {
  transform: scale(0.98);
}

.ai-hub__glow {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 30% 30%, rgba(232, 217, 195, 0.25), transparent 60%);
  pointer-events: none;
  opacity: 0.6;
}

.ai-hub__core {
  display: flex;
  align-items: center;
  padding: 22rpx 28rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  position: relative;
  overflow: hidden;
}

/* 数字人图（高瘦比例 1:1.36） */
.ai-hub__icon-img {
  width: 96rpx;
  height: 130rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.ai-hub__body {
  flex: 1;
  position: relative;
  z-index: 1;
}

.ai-hub__title {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}

.ai-hub__tags {
  font-size: 24rpx;
  color: var(--text-hint);
  letter-spacing: 1rpx;
}

.ai-hub__arrow {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #C8A878;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #FFFFFF;
  flex-shrink: 0;
}

/* ===== 4 大服务网格 ===== */
.service-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 28rpx 26rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(120, 95, 65, 0.08);
  border: 1rpx solid #E8D9C3;
}

.service-item:active {
  transform: scale(0.97);
}

.service-item__icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: #F7EFE3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  color: #C8A878;
  margin-bottom: 18rpx;
}

.service-item__name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.service-item__desc {
  font-size: 22rpx;
  color: var(--text-hint);
  line-height: 1.4;
}

/* ===== 今日日期（压缩小条） ===== */
.cal-card {
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  border: 1rpx solid #E8D9C3;
  border-left: 6rpx solid #C8A878;
}
.cal-card:active { transform: scale(0.98); }
.cal-card__icon { font-size: 32rpx; margin-right: 16rpx; flex-shrink: 0; color: #C8A878; }
.cal-card__date { flex: 1; font-size: 24rpx; color: var(--text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cal-card__arrow { font-size: 32rpx; color: var(--text-hint); margin-left: 12rpx; }

/* ===== 今日汇率卡片 ===== */
.rate-card {
  padding: 28rpx 32rpx;
  background: #FFFFFF;
  border: 1rpx solid #E8D9C3;
}

.rate-main {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.rate-base {
  font-size: 28rpx;
  font-weight: 600;
  color: #C8A878;
}
.rate-eq {
  font-size: 26rpx;
  color: var(--text-hint);
}
.rate-big {
  font-size: 42rpx;
  font-weight: 800;
  color: var(--text-secondary);
}
.rate-sub {
  line-height: 1.5;
  color: var(--text-hint);
}
.rate-update {
  text-align: right;
  color: var(--text-hint);
}

/* 免责声明 */
.disclaimer {
  margin: 32rpx 24rpx 40rpx;
  font-size: 20rpx;
  color: var(--text-hint);
  line-height: 1.6;
  text-align: center;
}
