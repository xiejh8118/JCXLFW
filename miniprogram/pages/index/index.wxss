/* pages/index/index.wxss */

.index-header {
  padding: 40rpx 30rpx 32rpx;
  background: linear-gradient(160deg, #6B3A0A 0%, var(--primary-dark) 40%, var(--primary) 100%);
  color: #FFFFFF;
  border-radius: 0 0 32rpx 32rpx;
}

.index-header__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.index-header__greeting {
  font-size: 22rpx;
  opacity: 0.75;
  margin-bottom: 2rpx;
}

.index-header__title {
  font-size: 40rpx;
  font-weight: 700;
}

.index-header__lang {
  background: rgba(255,255,255,0.18);
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: 500;
  flex-shrink: 0;
}

/* 商务服务入口 */
.svc-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 24rpx 8rpx;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #B8860B 0%, #D4A017 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(184,134,11,0.25);
}

.svc-banner:active {
  transform: scale(0.98);
}

.svc-banner__left {
  flex: 1;
}

.svc-banner__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 6rpx;
}

.svc-banner__subtitle {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

.svc-banner__arrow {
  font-size: 28rpx;
  color: rgba(255,255,255,0.7);
}

/* 合规体检入口 */
.checkup-banner {
  display: flex;
  align-items: center;
  background: #FFF;
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  margin: 20rpx 0;
  border-left: 8rpx solid #B8860B;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.checkup-banner__badge {
  background: #B8860B;
  color: #FFF;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.checkup-banner__body {
  flex: 1;
}
.checkup-banner__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}
.checkup-banner__subtitle {
  font-size: 24rpx;
  color: #999;
}
.checkup-banner__arrow {
  font-size: 28rpx;
  color: #CCC;
}

/* 会员中心入口 */
.member-entry {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #6B3A0A 0%, #B8860B 100%);
  border-radius: 16rpx;
  padding: 28rpx;
  margin: 20rpx 0 40rpx;
}
.member-entry__icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}
.member-entry__body {
  flex: 1;
}
.member-entry__title {
  font-size: 30rpx;
  font-weight: 500;
  color: #FFF;
  margin-bottom: 4rpx;
}
.member-entry__subtitle {
  font-size: 22rpx;
  color: rgba(255,255,255,0.75);
}
.member-entry__arrow {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
}

/* 中鼎物业入口 */
.property-entry {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #096dd9 0%, #1890ff 100%);
  border-radius: 16rpx;
  padding: 28rpx;
  margin: 0 0 40rpx;
}
.property-entry__icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}
.property-entry__body {
  flex: 1;
}
.property-entry__title {
  font-size: 30rpx;
  font-weight: 500;
  color: #FFF;
  margin-bottom: 4rpx;
}
.property-entry__subtitle {
  font-size: 22rpx;
  color: rgba(255,255,255,0.75);
}
.property-entry__arrow {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
}

/* 服务网格 */
.service-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 12rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
}

.service-item:active {
  transform: scale(0.95);
}

.service-item__icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 10rpx;
}

.service-item__name {
  font-size: 22rpx;
  color: var(--text-primary);
  text-align: center;
}

/* 工具网格 */
.tool-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
}

.tool-item:active {
  transform: scale(0.95);
}

.tool-item__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  margin-bottom: 8rpx;
}

.tool-item__name {
  font-size: 22rpx;
  color: var(--text-primary);
  text-align: center;
}

/* 今日汇率卡片 */
.rate-card {
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #FFF9F0 0%, #FFFFFF 100%);
  border: 1rpx solid rgba(184,134,11,0.15);
}

.rate-row {
  margin-bottom: 16rpx;
}

.rate-pair {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.rate-currency {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-bottom: 6rpx;
}

.rate-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
}

.rate-update {
  text-align: right;
}

