/* pages/index/index.wxss */

.index-header {
  padding: 40rpx 30rpx 32rpx;
  background: linear-gradient(160deg, #6B3A0A 0%, var(--primary-dark) 40%, var(--primary) 100%);
  color: #FFFFFF;
  border-radius: 0 0 32rpx 32rpx;
}

.index-header__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.index-header__greeting {
  font-size: 22rpx;
  opacity: 0.75;
  margin-bottom: 2rpx;
}

.index-header__title {
  font-size: 40rpx;
  font-weight: 700;
}

.index-header__lang {
  background: rgba(255,255,255,0.18);
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: 500;
  flex-shrink: 0;
}

/* 商务服务入口 */
.svc-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 24rpx 8rpx;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #B8860B 0%, #D4A017 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(184,134,11,0.25);
}

.svc-banner:active {
  transform: scale(0.98);
}

.svc-banner__left {
  flex: 1;
}

.svc-banner__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 6rpx;
}

.svc-banner__subtitle {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

.svc-banner__arrow {
  font-size: 28rpx;
  color: rgba(255,255,255,0.7);
}

/* 合规体检入口 */
.checkup-banner {
  display: flex;
  align-items: center;
  background: #FFF;
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  margin: 20rpx 0;
  border-left: 8rpx solid #B8860B;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.checkup-banner__badge {
  background: #B8860B;
  color: #FFF;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.checkup-banner__body {
  flex: 1;
}
.checkup-banner__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}
.checkup-banner__subtitle {
  font-size: 24rpx;
  color: #999;
}
.checkup-banner__arrow {
  font-size: 28rpx;
  color: #CCC;
}

/* 服务网格 */
.service-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 12rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
}

.service-item:active {
  transform: scale(0.95);
}

.service-item__icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 10rpx;
}

.service-item__name {
  font-size: 22rpx;
  color: var(--text-primary);
  text-align: center;
}

/* 工具网格 */
.tool-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
}

.tool-item:active {
  transform: scale(0.95);
}

.tool-item__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  margin-bottom: 8rpx;
}

.tool-item__name {
  font-size: 22rpx;
  color: var(--text-primary);
  text-align: center;
}

/* 今日汇率卡片 */
.rate-card {
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #FFF9F0 0%, #FFFFFF 100%);
  border: 1rpx solid rgba(184,134,11,0.15);
}

.rate-row {
  margin-bottom: 16rpx;
}

.rate-pair {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.rate-currency {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-bottom: 6rpx;
}

.rate-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
}

.rate-update {
  text-align: right;
}

/* 美元基准展示 */
.rate-main {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.rate-base {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary);
}
.rate-eq {
  font-size: 26rpx;
  color: var(--text-hint);
}
.rate-big {
  font-size: 42rpx;
  font-weight: 800;
  color: var(--primary);
}
.rate-sub {
  line-height: 1.5;
}

/* ===== 新定位样式（柬企海外商旅服务 / KHMER） ===== */

/* 平台定位横幅 */
.platform-banner {
  margin: 24rpx 24rpx 8rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #B8860B 0%, #D4A017 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(184,134,11,0.25);
}
.platform-banner__text {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.5;
}

/* 场景网格（4 大场景，2 列） */
.scenario-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}
.scenario-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 28rpx 28rpx 32rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
}
.scenario-item:active {
  transform: scale(0.97);
}
.scenario-item__icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 16rpx;
}
.scenario-item__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}
.scenario-item__desc {
  font-size: 22rpx;
  color: var(--text-hint);
}

/* 需求单 CTA */
.cta-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx;
  background: linear-gradient(135deg, #2C3E50 0%, #34495E 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(44,62,80,0.25);
}
.cta-card:active {
  transform: scale(0.98);
}
.cta-card__left {
  flex: 1;
}
.cta-card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}
.cta-card__subtitle {
  font-size: 22rpx;
  color: rgba(255,255,255,0.75);
}
.cta-card__btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  background: #B8860B;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 16rpx 28rpx;
  border-radius: 30rpx;
}

/* 智能客服卡片 */
.cs-card {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #B8860B 0%, #D4A017 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(184,134,11,0.25);
}
.cs-card:active {
  transform: scale(0.98);
}
.cs-card__icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}
.cs-card__left {
  flex: 1;
}
.cs-card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}
.cs-card__subtitle {
  font-size: 22rpx;
  color: rgba(255,255,255,0.85);
}
.cs-card__btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
}

/* 免责声明 */
.disclaimer {
  margin: 32rpx 24rpx 40rpx;
  font-size: 20rpx;
  color: var(--text-hint);
  line-height: 1.6;
  text-align: center;
}

