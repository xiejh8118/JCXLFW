<!-- pages/index/index.wxml - 首页（KHMER AI 2.0 柬埔寨酒店 AI 商旅后勤平台） -->
<view class="container">
  <!-- 顶部头部 -->
  <view class="index-header">
    <view class="index-header__row">
      <view>
        <view class="index-header__greeting">{{sectionTitles.greeting}}</view>
        <view class="index-header__title">{{sectionTitles.appName}}</view>
        <view class="index-header__subtitle">{{sectionTitles.subtitle}}</view>
      </view>
      <view class="index-header__lang" bindtap="onLangSwitch">
        <text>{{languageLabel}}</text>
      </view>
    </view>
  </view>

  <!-- 平台定位一句话 -->
  <view class="platform-banner">
    <text class="platform-banner__text">{{sectionTitles.slogan}}</text>
  </view>

  <!-- 4 大场景 -->
  <view class="section">
    <view class="section__title">{{sectionTitles.scenarios}}</view>
    <view class="scenario-grid">
      <view
        class="scenario-item"
        wx:for="{{scenarios}}"
        wx:key="id"
        data-page="{{item.page}}"
        data-id="{{item.id}}"
        data-rqtype="{{item.rqType}}"
        bindtap="onItemTap"
      >
        <view class="scenario-item__icon" style="background: {{item.color}}20;">
          <text>{{item.icon}}</text>
        </view>
        <view class="scenario-item__name">{{item.name}}</view>
        <view class="scenario-item__desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <!-- 快捷提交需求单 -->
  <view class="section">
    <view class="cta-card" bindtap="onSubmitRequirement">
      <view class="cta-card__left">
        <view class="cta-card__title">{{sectionTitles.submitTitle}}</view>
        <view class="cta-card__subtitle">{{sectionTitles.submitSubtitle}}</view>
      </view>
      <view class="cta-card__btn">{{sectionTitles.submitBtn}} ></view>
    </view>
  </view>

  <!-- 今日汇率（美元基准） -->
  <view class="section">
    <view class="section__title">{{sectionTitles.todayRate}}</view>
    <view class="rate-card card">
      <view class="rate-main">
        <text class="rate-base">1 USD</text>
        <text class="rate-eq">≈</text>
        <text class="rate-big">{{rates.USD_KHR}} KHR</text>
      </view>
      <view class="rate-sub text-hint text-sm">
        1 CNY ≈ {{rates.CNY_KHR}} KHR · {{sectionTitles.settleUSD}}
      </view>
      <view class="rate-update text-hint text-sm" wx:if="{{rateUpdateTime}}">
        {{sectionTitles.lastUpdate}} {{rateUpdateTime}}
      </view>
    </view>
  </view>

  <!-- 免责声明 -->
  <view class="disclaimer">{{sectionTitles.disclaimer}}</view>
</view>
