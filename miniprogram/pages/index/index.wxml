<!-- pages/index/index.wxml - 首页（红金重工商务风 / AI 智能服务中枢） -->
<view class="container">
  <!-- 顶部头部 -->
  <view class="index-header">
    <view class="index-header__bg-pattern"></view>
    <view class="index-header__row">
      <view class="index-header__brand">
        <image class="index-header__logo" src="/images/logo.png" mode="aspectFit" />
        <view class="index-header__text">
          <view class="index-header__greeting">{{sectionTitles.greeting}}</view>
          <view class="index-header__title">{{sectionTitles.appName}}</view>
          <view class="index-header__subtitle">{{sectionTitles.subtitle}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- AI 智能服务中枢（核心悬浮入口） -->
  <view class="section">
    <view class="ai-hub" bindtap="onOpenHelp">
      <view class="ai-hub__glow"></view>
      <view class="ai-hub__core">
        <image class="ai-hub__icon-img" src="/images/ai_hub.png" mode="aspectFit" />
        <view class="ai-hub__body">
          <view class="ai-hub__title">{{sectionTitles.aiHubTitle}}</view>
          <view class="ai-hub__tags">{{sectionTitles.aiHubTags}}</view>
        </view>
        <view class="ai-hub__arrow">›</view>
      </view>
    </view>
  </view>

  <!-- 4 大核心服务入口 -->
  <view class="section">
    <view class="section__title">{{sectionTitles.scenarios}}</view>
    <view class="service-grid">
      <view
        class="service-item"
        wx:for="{{scenarios}}"
        wx:key="id"
        data-page="{{item.page}}"
        data-id="{{item.id}}"
        data-rqtype="{{item.rqType}}"
        data-action="{{item.action}}"
        bindtap="onItemTap"
      >
        <view class="service-item__icon">
          <text>{{item.icon}}</text>
        </view>
        <view class="service-item__name">{{item.name}}</view>
        <view class="service-item__desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <!-- 今日日期（佛历 / 高棉日期）压缩小条 -->
  <view class="section">
    <view class="cal-card" bindtap="showCalendarTool">
      <view class="cal-card__icon">📅</view>
      <view class="cal-card__date">{{calendar.greg}} · 佛历{{calendar.beYear}} · {{calendar.khmerDate}}</view>
      <view class="cal-card__arrow">›</view>
    </view>
  </view>

  <!-- 今日汇率（美元基准） -->
  <view class="section">
    <view class="section__title">{{sectionTitles.todayRate}}</view>
    <view class="rate-card card">
      <view class="rate-main">
        <text class="rate-base">1 USD</text>
        <text class="rate-eq">≈</text>
        <text class="rate-big">{{rates.USD_KHR}} KHR</text>
      </view>
      <view class="rate-sub text-hint text-sm">
        1 CNY ≈ {{rates.CNY_KHR}} KHR · {{sectionTitles.settleUSD}}
      </view>
      <view class="rate-update text-hint text-sm" wx:if="{{rateUpdateTime}}">
        {{sectionTitles.lastUpdate}} {{rateUpdateTime}}
      </view>
    </view>
  </view>

  <!-- 免责声明 -->
  <view class="disclaimer">{{sectionTitles.disclaimer}}</view>
</view>
