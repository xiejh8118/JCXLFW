<!-- pages/tax-tool/tax-tool.wxml - 税务工具箱 -->
<view class="container">
  <!-- 页面头部 -->
  <view class="page-header">
    <view class="page-header__title">税务工具箱</view>
    <view class="page-header__subtitle">柬埔寨税规计算 · 实时精准</view>
  </view>

  <!-- Tab 切换 -->
  <view class="tax-tabs">
    <view 
      class="tax-tab {{activeType === item.key ? 'tax-tab--active' : ''}}"
      wx:for="{{types}}" wx:key="key"
      data-key="{{item.key}}" bindtap="onTypeChange"
    >
      <text class="mr-10">{{item.icon}}</text>{{item.label}}
    </view>
  </view>

  <!-- ======== VAT 增值税 ======== -->
  <view class="section" wx:if="{{activeType === 'vat'}}">
    <view class="card">
      <view class="fw-bold mb-20">增值税 (VAT) 计算器</view>

      <!-- 计算模式切换 -->
      <view class="flex mb-20">
        <view 
          class="mode-btn {{vat.mode === 'exclusive' ? 'mode-btn--active' : ''}}"
          data-mode="exclusive" bindtap="onVatModeChange"
        >不含税 → 含税</view>
        <view 
          class="mode-btn {{vat.mode === 'inclusive' ? 'mode-btn--active' : ''}}"
          data-mode="inclusive" bindtap="onVatModeChange"
        >含税 → 不含税</view>
      </view>

      <block wx:if="{{vat.mode === 'exclusive'}}">
        <view class="form-group">
          <view class="form-label">不含税金额 (USD)</view>
          <input 
            class="form-input" 
            type="digit" 
            placeholder="输入金额..."
            value="{{vat.amount}}"
            bindinput="onVatAmountInput"
          />
        </view>
      </block>

      <block wx:if="{{vat.mode === 'inclusive'}}">
        <view class="form-group">
          <view class="form-label">含税金额 (USD)</view>
          <input 
            class="form-input" 
            type="digit" 
            placeholder="输入含税金额..."
            value="{{vat.amountIncl}}"
            bindinput="onVatAmountInclInput"
          />
        </view>
      </block>

      <view class="form-group">
        <view class="form-label">增值税税率</view>
        <view class="rate-display">{{vat.rate}}% (标准税率)</view>
      </view>

      <!-- 快速填入 -->
      <view class="flex flex-wrap mb-20">
        <view class="quick-tag" wx:for="{{[100,500,1000,5000,10000]}}" wx:key="*this" data-amount="{{item}}" bindtap="onQuickAmount">${{item}}</view>
      </view>

      <view class="flex">
        <view class="btn btn--outline flex-1 mr-10" bindtap="onReset">重置</view>
        <view class="btn btn--primary flex-1" bindtap="calcVAT">计算</view>
      </view>

      <!-- 计算结果 -->
      <view class="result-card" wx:if="{{vat.result}}">
        <view class="result-card__header flex-between">
          <view class="fw-bold">计算结果</view>
          <view class="text-primary text-sm" bindtap="onCopyResult">📋 复制</view>
        </view>
        <view class="divider"></view>
        <view class="result-row flex-between">
          <text>不含税金额</text>
          <text class="fw-bold">${{vat.result.beforeTax}}</text>
        </view>
        <view class="result-row flex-between">
          <text>税率</text>
          <text class="text-accent">{{vat.result.taxRate}}%</text>
        </view>
        <view class="result-row flex-between">
          <text>增值税额</text>
          <text class="text-danger fw-bold">${{vat.result.taxAmount}}</text>
        </view>
        <view class="result-row result-row--total flex-between">
          <text>含税总金额</text>
          <text class="text-xl fw-bold price price--usd">{{vat.result.afterTax}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ======== WHT 代扣税 ======== -->
  <view class="section" wx:if="{{activeType === 'wht'}}">
    <view class="card">
      <view class="fw-bold mb-20">代扣税 (WHT) 计算器</view>

      <view class="form-group">
        <view class="form-label">支付金额 (USD)</view>
        <input 
          class="form-input" 
          type="digit" 
          placeholder="输入金额..."
          value="{{wht.amount}}"
          bindinput="onWhtAmountInput"
        />
      </view>

      <view class="form-group">
        <view class="form-label">费用类别</view>
        <picker mode="selector" range="{{wht.categories}}" range-key="name" value="{{wht.category}}" bindchange="onWhtCategoryChange">
          <view class="form-input flex-between">
            <text wx:if="{{wht.categories.length}}">{{whtCategoryName}}</text>
            <text wx:else>加载中...</text>
            <text class="text-hint">▼</text>
          </view>
        </picker>
      </view>

      <view class="flex flex-wrap mb-20">
        <view class="quick-tag" wx:for="{{[500,1000,5000,10000,50000]}}" wx:key="*this" data-amount="{{item}}" bindtap="onQuickAmount">${{item}}</view>
      </view>

      <view class="flex">
        <view class="btn btn--outline flex-1 mr-10" bindtap="onReset">重置</view>
        <view class="btn btn--primary flex-1" bindtap="calcWHT">计算</view>
      </view>

      <view class="result-card" wx:if="{{wht.result}}">
        <view class="result-card__header flex-between">
          <view class="fw-bold">计算结果</view>
          <view class="text-primary text-sm" bindtap="onCopyResult">📋 复制</view>
        </view>
        <view class="divider"></view>
        <view class="result-row flex-between">
          <text>支付金额</text>
          <text class="fw-bold">${{wht.result.amount}}</text>
        </view>
        <view class="result-row flex-between">
          <text>费用类别</text>
          <text>{{wht.result.category}}</text>
        </view>
        <view class="result-row flex-between">
          <text>代扣税率</text>
          <text class="text-accent">{{wht.result.taxRate}}%</text>
        </view>
        <view class="result-row flex-between">
          <text>代扣税额</text>
          <text class="text-danger fw-bold">${{wht.result.taxAmount}}</text>
        </view>
        <view class="result-row result-row--total flex-between">
          <text>实际支付</text>
          <text class="text-xl fw-bold price price--usd">{{wht.result.netAmount}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ======== Salary Tax 薪资税 ======== -->
  <view class="section" wx:if="{{activeType === 'salary'}}">
    <view class="card">
      <view class="fw-bold mb-20">薪资个税计算器</view>
      <view class="text-sm text-hint mb-20">柬埔寨薪资税采用累进税率 (0%-20%)，月抵扣 150,000៛</view>

      <view class="form-group">
        <view class="form-label">月薪 (瑞尔 KHR)</view>
        <input 
          class="form-input" 
          type="digit" 
          placeholder="例如: 3000000"
          value="{{salary.amountKHR}}"
          bindinput="onSalaryAmountInput"
        />
      </view>

      <view class="tax-brackets mb-20">
        <view class="text-sm text-hint mb-10">税率表参考:</view>
        <view class="bracket-row flex-between text-sm" wx:for="{{['0-1,500,000៛: 0%','1,500,001-2,000,000៛: 5%','2,000,001-8,500,000៛: 10%','8,500,001-12,500,000៛: 15%','12,500,001+៛: 20%']}}" wx:key="*this">
          <text>{{item}}</text>
        </view>
      </view>

      <view class="flex">
        <view class="btn btn--outline flex-1 mr-10" bindtap="onReset">重置</view>
        <view class="btn btn--primary flex-1" bindtap="calcSalaryTax">计算</view>
      </view>

      <view class="result-card" wx:if="{{salary.result}}">
        <view class="result-card__header flex-between">
          <view class="fw-bold">计算结果</view>
          <view class="text-primary text-sm" bindtap="onCopyResult">📋 复制</view>
        </view>
        <view class="divider"></view>
        <view class="result-row flex-between">
          <text>月薪 (KHR)</text>
          <text class="fw-bold">{{salary.result.monthlySalary}}៛</text>
        </view>
        <view class="result-row flex-between">
          <text>年薪 (KHR)</text>
          <text>{{salary.result.annualSalary}}៛</text>
        </view>
        <view class="result-row flex-between">
          <text>有效税率</text>
          <text class="text-accent">{{salary.result.effectiveRate}}%</text>
        </view>
        <view class="result-row flex-between">
          <text>月扣税额</text>
          <text class="text-danger fw-bold">{{salary.result.monthlyTax}}៛</text>
        </view>
        <view class="result-row result-row--total flex-between">
          <text>年扣税额</text>
          <text class="text-xl fw-bold">{{salary.result.annualTax}}៛</text>
        </view>
      </view>
    </view>
  </view>
</view>
