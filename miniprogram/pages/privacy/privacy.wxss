/* pages/privacy/privacy.wxss */
.privacy {
  padding: 32rpx 36rpx 80rpx;
  background: var(--bg-primary);
  min-height: 100vh;
  box-sizing: border-box;
}
.privacy__title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2b2b2b;
  text-align: center;
}
.privacy__updated {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: 8rpx;
  margin-bottom: 28rpx;
}
.privacy__block {
  margin-bottom: 28rpx;
}
.privacy__h {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 10rpx;
}
.privacy__p {
  font-size: 27rpx;
  color: #444;
  line-height: 1.7;
  white-space: pre-wrap;
}
.privacy__foot {
  margin-top: 40rpx;
  font-size: 22rpx;
  color: #bbb;
  text-align: center;
}
