/* pages/property/property.wxss - 中鼎物业工作台 */

page { background: #f0f2f5; }

/* ===== 登录遮罩 ===== */
.login-overlay {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  display: flex; align-items: center; justify-content: center;
  z-index: 999;
}
.login-card {
  width: 86%; max-width: 340px;
  background: #fff; border-radius: 16px;
  padding: 40rpx 36rpx; text-align: center;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,.15);
}
.login-logo { width: 200rpx; height: 80rpx; margin: 0 auto 10rpx; display: block; }
.login-title { font-size: 38rpx; font-weight: 700; color: #262626; }
.login-subtitle { font-size: 24rpx; color: #8c8c8c; margin: 8rpx 0 36rpx; }
.login-field { text-align: left; margin-bottom: 24rpx; }
.login-label { display: block; font-size: 26rpx; color: #595959; margin-bottom: 10rpx; }
.login-input {
  width: 100%; height: 80rpx; border: 1px solid #d9d9d9;
  border-radius: 8rpx; padding: 0 20rpx; font-size: 30rpx; box-sizing: border-box;
}
.login-input:focus { border-color: #1890ff; }
.login-error { color: #ff4d4f; font-size: 26rpx; margin-bottom: 16rpx; }
.login-btn {
  width: 100%; height: 88rpx; line-height: 88rpx;
  background: #1890ff; color: #fff; border: none;
  border-radius: 8rpx; font-size: 32rpx; font-weight: 600;
}
.login-btn::after { border: none; }
.login-hint { font-size: 22rpx; color: #bfbfbf; margin-top: 20rpx; }

/* ===== 容器 ===== */
.container { padding: 20rpx 24rpx 120rpx; }

/* ===== 顶部用户栏 ===== */
.top-bar {
  display: flex; align-items: center; justify-content: space-between;
  background: #fff; border-radius: 12rpx; padding: 20rpx 24rpx;
  margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.05);
}
.top-bar__user { display: flex; align-items: center; gap: 16rpx; }
.top-bar__avatar {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 700; color: #fff;
}
.top-bar__avatar.admin { background: #1890ff; }
.top-bar__avatar.operator { background: #52c41a; }
.top-bar__info { display: flex; flex-direction: column; }
.top-bar__name { font-size: 30rpx; font-weight: 600; color: #262626; }
.top-bar__role { font-size: 22rpx; color: #8c8c8c; }
.top-bar__logout {
  font-size: 26rpx; color: #ff4d4f; padding: 8rpx 20rpx;
  border: 1px solid #ffa39e; border-radius: 8rpx;
}

/* ===== 统计卡片 ===== */
.stats-row {
  display: flex; gap: 16rpx; margin-bottom: 20rpx;
}
.stat-card {
  flex: 1; background: #fff; border-radius: 12rpx;
  padding: 20rpx 12rpx; text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.05);
}
.stat-card__value {
  font-size: 40rpx; font-weight: 700; color: #1890ff; display: block;
}
.stat-card__value--sm { font-size: 30rpx; }
.stat-card__label { font-size: 22rpx; color: #8c8c8c; display: block; margin-top: 6rpx; }
.stat-card--danger .stat-card__value { color: #ff4d4f; }
.stat-card--success .stat-card__value { color: #52c41a; }

/* ===== Tab 导航 ===== */
.tab-nav {
  display: flex; background: #fff; border-radius: 12rpx;
  overflow: hidden; margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.05);
}
.tab-btn {
  flex: 1; padding: 22rpx 0; text-align: center;
  font-size: 28rpx; color: #595959;
  border-bottom: 4rpx solid transparent;
}
.tab-btn.active { color: #1890ff; border-bottom-color: #1890ff; font-weight: 600; }

/* ===== 今日待办 ===== */
.today-empty {
  text-align: center; padding: 80rpx 0; color: #8c8c8c;
}
.today-empty__icon { font-size: 80rpx; display: block; margin-bottom: 16rpx; }
.today-empty__text { font-size: 28rpx; }

.today-item {
  display: flex; align-items: center; justify-content: space-between;
  background: #fff; border-radius: 12rpx; padding: 24rpx;
  margin-bottom: 16rpx; border-left: 8rpx solid #1890ff;
}
.today-item--overdue { border-left-color: #ff4d4f; background: #fff1f0; }
.today-item--warning { border-left-color: #faad14; background: #fffbe6; }
.today-item--info { border-left-color: #1890ff; background: #e6f7ff; }
.today-item--lowElec { border-left-color: #fa541c; background: #fff2e8; }
.today-item--lowElec .today-item__tag { background: #fa541c; }
.today-item--lowElec .today-item__amount { color: #fa541c; }
.today-item__left { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; flex: 1; }
.today-item__room { font-size: 32rpx; font-weight: 700; color: #262626; }
.today-item__month { font-size: 24rpx; color: #8c8c8c; }
.today-item__amount { font-size: 30rpx; font-weight: 600; color: #ff4d4f; }
.today-item__tag {
  font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 6rpx;
  background: #ff4d4f; color: #fff;
}
.today-item--warning .today-item__tag { background: #faad14; }
.today-item--info .today-item__tag { background: #1890ff; }
.today-item__actions { display: flex; gap: 12rpx; }

.mini-btn {
  font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 8rpx;
  background: #f5f5f5; color: #595959; border: 1px solid #d9d9d9;
}
.mini-btn--primary { background: #1890ff; color: #fff; border-color: #1890ff; }
.mini-btn--danger { color: #ff4d4f; border-color: #ffa39e; }
.mini-btn--pdf { color: var(--primary); border-color: rgba(27, 58, 95, 0.25); background: #E8EEF4; }
.mini-btn--elec { color: #fa541c; border-color: #ffbb96; background: #fff2e8; }

/* ===== 筛选栏 ===== */
.filter-bar {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 20rpx;
}
.filter-picker__inner {
  background: #fff; border-radius: 8rpx; padding: 14rpx 24rpx;
  font-size: 28rpx; color: #262626; display: flex; align-items: center; gap: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.05);
}
.filter-arrow { color: #bfbfbf; font-size: 24rpx; }
.filter-count { font-size: 24rpx; color: #8c8c8c; }

/* ===== 空状态 ===== */
.empty-state {
  text-align: center; padding: 80rpx 0; color: #8c8c8c;
}
.empty-state__icon { font-size: 80rpx; display: block; margin-bottom: 16rpx; }
.empty-state__text { font-size: 28rpx; display: block; margin-bottom: 24rpx; }
.empty-state__btn {
  display: inline-block; padding: 16rpx 40rpx; background: #1890ff;
  color: #fff; border-radius: 8rpx; font-size: 28rpx;
}

/* ===== 台账卡片 ===== */
.record-card {
  background: #fff; border-radius: 12rpx; margin-bottom: 20rpx;
  overflow: hidden; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.05);
}
.record-card__header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx; border-bottom: 1px solid #f0f0f0;
}
.record-card__room { display: flex; align-items: baseline; gap: 16rpx; }
.record-card__room-no { font-size: 34rpx; font-weight: 700; color: #262626; }
.record-card__month { font-size: 24rpx; color: #8c8c8c; }
.record-card__badges { display: flex; gap: 12rpx; }

.status-badge, .collect-badge, .elec-badge {
  font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 6rpx; font-weight: 500;
}
.status-badge--unpaid { background: #fff1f0; color: #ff4d4f; }
.status-badge--paid { background: #f6ffed; color: #52c41a; }
.status-badge--partial { background: #fffbe6; color: #faad14; }
.collect-badge--uncollected { background: #f5f5f5; color: #bfbfbf; }
.collect-badge--collected { background: #e6f7ff; color: #1890ff; }
.collect-badge--promised { background: #fffbe6; color: #faad14; }
.collect-badge--settled { background: #f6ffed; color: #52c41a; }
.elec-badge--low { background: #fff2e8; color: #fa541c; }

.record-card__body { padding: 20rpx 24rpx; }
.record-detail__row {
  display: flex; justify-content: space-between; padding: 8rpx 0;
}
.record-detail__label { font-size: 26rpx; color: #8c8c8c; }
.record-detail__value { font-size: 26rpx; color: #262626; }
.record-detail__row--total { border-top: 1px solid #f0f0f0; margin-top: 8rpx; padding-top: 16rpx; }
.record-detail__value--total { font-size: 32rpx; font-weight: 700; color: #ff4d4f; }

.record-card__actions {
  display: flex; gap: 16rpx; padding: 16rpx 24rpx; border-top: 1px solid #f0f0f0;
}

/* ===== 抄表表单 ===== */
.form-card {
  background: #fff; border-radius: 12rpx; padding: 24rpx;
  margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.05);
}
.form-card__title { font-size: 32rpx; font-weight: 600; color: #262626; margin-bottom: 20rpx; }
.form-divider {
  font-size: 24rpx; color: #1890ff; font-weight: 600;
  margin: 20rpx 0 12rpx; padding-bottom: 8rpx; border-bottom: 1px solid #e6f7ff;
}
.form-row { margin-bottom: 20rpx; }
.form-row--double { display: flex; gap: 20rpx; }
.form-cell { flex: 1; }
.form-label { display: block; font-size: 24rpx; color: #8c8c8c; margin-bottom: 10rpx; }
.form-label__hint { font-size: 20rpx; color: #bfbfbf; margin-left: 8rpx; }
.form-input {
  width: 100%; height: 76rpx; border: 1px solid #d9d9d9;
  border-radius: 8rpx; padding: 0 20rpx; font-size: 28rpx; box-sizing: border-box;
}
.form-input--picker {
  display: flex; align-items: center; justify-content: space-between;
  color: #262626; line-height: 76rpx;
}
.form-input--placeholder {
  color: #bfbfbf;
}

/* 房号输入联想 */
.room-input-wrap {
  position: relative;
}
.room-suggest {
  position: absolute; left: 0; right: 0; top: 80rpx; z-index: 50;
  background: #fff; border: 1px solid #e0e0e0; border-radius: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.12); max-height: 360rpx; overflow-y: auto;
}
.room-suggest__item {
  padding: 18rpx 20rpx; font-size: 28rpx; color: #262626;
  border-bottom: 1px solid #f0f0f0;
}
.room-suggest__item:last-child { border-bottom: none; }
.room-suggest__item:active { background: #f5f5f5; }
.room-suggest__empty {
  padding: 18rpx 20rpx; font-size: 26rpx; color: #bfbfbf; text-align: center;
}

.calc-preview {
  background: #f6ffed; border: 1px solid #b7eb8f; border-radius: 8rpx;
  padding: 20rpx; margin: 20rpx 0;
}
.calc-preview__row {
  display: flex; justify-content: space-between; padding: 6rpx 0;
  font-size: 26rpx; color: #595959;
}
.calc-preview__row--total {
  border-top: 1px solid #b7eb8f; margin-top: 8rpx; padding-top: 14rpx;
  font-size: 32rpx; font-weight: 700; color: #389e0d;
}
.calc-preview__row--warn {
  color: #fa541c; font-weight: 600;
  border-top: 1px dashed #ffbb96; margin-top: 8rpx; padding-top: 12rpx;
}

.form-actions { display: flex; gap: 20rpx; }
.form-btn {
  flex: 1; height: 84rpx; line-height: 84rpx; border-radius: 8rpx;
  font-size: 30rpx; font-weight: 600; border: none;
}
.form-btn::after { border: none; }
.form-btn--primary { background: #1890ff; color: #fff; }
.form-btn--ghost { background: #f5f5f5; color: #595959; border: 1px solid #d9d9d9; }

/* ===== 用户管理 ===== */
.user-card {
  display: flex; align-items: center; justify-content: space-between;
  background: #fff; border-radius: 12rpx; padding: 24rpx;
  margin-bottom: 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.05);
}
.user-card__left { display: flex; align-items: center; gap: 16rpx; }
.user-card__avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; font-weight: 700; color: #fff;
}
.user-card__avatar.admin { background: #1890ff; }
.user-card__avatar.operator { background: #52c41a; }
.user-card__info { display: flex; flex-direction: column; gap: 4rpx; }
.user-card__name { font-size: 30rpx; font-weight: 600; color: #262626; }
.user-card__created { font-size: 22rpx; color: #bfbfbf; }
.role-badge { font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 6rpx; align-self: flex-start; }
.role-badge--admin { background: #e6f7ff; color: #1890ff; }
.role-badge--operator { background: #f6ffed; color: #52c41a; }
.user-card__actions { display: flex; gap: 12rpx; }

.add-user-btn {
  text-align: center; padding: 28rpx; background: #fff; border-radius: 12rpx;
  color: #1890ff; font-size: 30rpx; border: 2rpx dashed #1890ff;
  margin-top: 20rpx;
}

/* ===== 权限选择 ===== */
.perm-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 10rpx;
}
.perm-item {
  display: flex; align-items: flex-start; gap: 10rpx;
  background: #f5f5f5; border: 1px solid #d9d9d9; border-radius: 10rpx;
  padding: 16rpx;
}
.perm-item--active {
  background: #e6f7ff; border-color: #1890ff;
}
.perm-item__check {
  font-size: 30rpx; color: #1890ff; line-height: 1;
  margin-top: 2rpx;
}
.perm-item__body {
  display: flex; flex-direction: column; gap: 4rpx;
}
.perm-item__label {
  font-size: 26rpx; color: #262626; font-weight: 500;
}
.perm-item__desc {
  font-size: 20rpx; color: #8c8c8c;
}

/* ===== 弹窗 ===== */
.modal-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,.45); z-index: 998;
  display: flex; align-items: center; justify-content: center;
}
.modal-card {
  width: 86%; max-width: 600rpx; background: #fff;
  border-radius: 16rpx; padding: 36rpx;
}
.modal-card__title { font-size: 34rpx; font-weight: 600; color: #262626; margin-bottom: 24rpx; }

/* 物业咨询按钮（替代 contact-bar） */
.property-consult-btn {
  margin: 32rpx 24rpx;
  padding: 20rpx 0;
  font-size: 30rpx;
  color: #1890ff;
  background: #fff;
  border: 1rpx solid #1890ff;
  border-radius: 8rpx;
}
.property-consult-btn::after {
  border: none;
}

/* 报修工单列表 */
.repair-list { padding: 0 24rpx 24rpx; }
.repair-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,.04);
}
.repair-item__top { display: flex; align-items: center; }
.repair-item__room { font-size: 28rpx; font-weight: 600; color: #262626; }
.repair-item__type {
  font-size: 22rpx; color: var(--primary); background: #E8EEF4;
  padding: 4rpx 14rpx; border-radius: 20rpx; margin: 0 12rpx;
}
.repair-item__status {
  font-size: 22rpx; color: #1565c0; background: #e3f2fd;
  padding: 4rpx 14rpx; border-radius: 20rpx; margin-left: auto;
}
.repair-item__detail { font-size: 24rpx; color: #666; margin-top: 10rpx; }
.repair-item__no { font-size: 22rpx; color: #999; margin-top: 8rpx; }
