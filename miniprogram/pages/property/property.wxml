<!-- pages/property/property.wxml - 中鼎物业工作台 -->

<!-- ===== 登录遮罩 ===== -->
<view class="login-overlay" wx:if="{{!isLoggedIn}}">
  <view class="login-card">
    <view class="login-logo">🏢</view>
    <view class="login-title">中鼎物业工作台</view>
    <view class="login-subtitle">收费台账 · 水电抄表 · 收缴管理</view>

    <view class="login-field">
      <text class="login-label">用户名</text>
      <input class="login-input" type="text" placeholder="请输入用户名" value="{{loginForm.username}}" data-field="username" bindinput="onLoginInput" />
    </view>
    <view class="login-field">
      <text class="login-label">密码</text>
      <input class="login-input" type="text" password="{{true}}" placeholder="请输入密码" value="{{loginForm.password}}" data-field="password" bindinput="onLoginInput" />
    </view>

    <view class="login-error" wx:if="{{loginError}}">{{loginError}}</view>

    <button class="login-btn" bindtap="doLogin">登 录</button>
    <view class="login-hint">默认账号 admin / admin123</view>
  </view>
</view>

<!-- ===== 主界面 ===== -->
<view class="container" wx:if="{{isLoggedIn}}">

  <!-- 顶部用户栏 -->
  <view class="top-bar">
    <view class="top-bar__user">
      <view class="top-bar__avatar {{isAdmin ? 'admin' : 'operator'}}">{{currentUser.avatarChar}}</view>
      <view class="top-bar__info">
        <text class="top-bar__name">{{currentUser.username}}</text>
        <text class="top-bar__role">{{isAdmin ? '管理员' : '操作员'}}</text>
      </view>
    </view>
    <view class="top-bar__logout" bindtap="logout">退出</view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-row">
    <view class="stat-card">
      <text class="stat-card__value">{{stats.totalRooms}}</text>
      <text class="stat-card__label">在管房数</text>
    </view>
    <view class="stat-card stat-card--danger">
      <text class="stat-card__value">{{stats.unpaidCount}}</text>
      <text class="stat-card__label">未缴笔数</text>
    </view>
    <view class="stat-card stat-card--danger">
      <text class="stat-card__value stat-card__value--sm">{{stats.unpaidAmountText}}</text>
      <text class="stat-card__label">欠费总额</text>
    </view>
    <view class="stat-card stat-card--success">
      <text class="stat-card__value stat-card__value--sm">{{stats.monthCollectedText}}</text>
      <text class="stat-card__label">本月已收</text>
    </view>
  </view>

  <!-- Tab 导航 -->
  <view class="tab-nav">
    <view class="tab-btn {{currentTab === 'today' ? 'active' : ''}}" data-tab="today" bindtap="switchTab">📋 待办</view>
    <view class="tab-btn {{currentTab === 'ledger' ? 'active' : ''}}" data-tab="ledger" bindtap="switchTab">📒 台账</view>
    <view class="tab-btn {{currentTab === 'meter' ? 'active' : ''}}" data-tab="meter" bindtap="switchTab">⚡ 抄表</view>
    <view class="tab-btn {{currentTab === 'users' ? 'active' : ''}}" data-tab="users" bindtap="switchTab" wx:if="{{isAdmin || permState.user_manage}}">👤 用户</view>
  </view>

  <!-- ===== 今日待办 ===== -->
  <view class="tab-content" wx:if="{{currentTab === 'today'}}">
    <view class="today-empty" wx:if="{{todayTasks.length === 0}}">
      <text class="today-empty__icon">✅</text>
      <text class="today-empty__text">暂无待处理事项</text>
    </view>

    <view class="today-item today-item--{{item.taskClass}}" wx:for="{{todayTasks}}" wx:key="id">
      <view class="today-item__left">
        <text class="today-item__room">{{item.room}}</text>
        <text class="today-item__month">{{item.month}}</text>
        <text class="today-item__amount">{{item.totalText}}</text>
        <text class="today-item__tag">{{item.taskLabel}}</text>
      </view>
      <view class="today-item__actions" wx:if="{{isAdmin || permState.ledger_edit}}">
        <view class="mini-btn mini-btn--primary" data-id="{{item.id}}" bindtap="markPaid">已缴</view>
        <view class="mini-btn" data-id="{{item.id}}" bindtap="cycleCollectStatus">催收</view>
      </view>
    </view>
  </view>

  <!-- ===== 收费台账 ===== -->
  <view class="tab-content" wx:if="{{currentTab === 'ledger'}}">
    <!-- 筛选栏 -->
    <view class="filter-bar">
      <picker class="filter-picker" value="{{filterMonth}}" range="{{filterMonths}}" bindchange="onFilterMonth">
        <view class="filter-picker__inner">
          <text>{{filterMonth || '全部月份'}}</text>
          <text class="filter-arrow">▾</text>
        </view>
      </picker>
      <view class="filter-count">共 {{displayRecords.length}} 条</view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{displayRecords.length === 0}}">
      <text class="empty-state__icon">📒</text>
      <text class="empty-state__text">暂无台账记录</text>
      <view class="empty-state__btn" data-tab="meter" bindtap="switchTab">去抄表录入</view>
    </view>

    <!-- 记录卡片列表 -->
    <view class="record-card" wx:for="{{displayRecords}}" wx:key="id">
      <view class="record-card__header">
        <view class="record-card__room">
          <text class="record-card__room-no">{{item.room}}</text>
          <text class="record-card__month">{{item.month}}</text>
        </view>
        <view class="record-card__badges">
          <text class="status-badge status-badge--{{item.payStatusClass}}" data-id="{{item.id}}" bindtap="cyclePayStatus">{{item.payStatus}}</text>
          <text class="collect-badge collect-badge--{{item.collectStatusClass}}" data-id="{{item.id}}" bindtap="cycleCollectStatus">{{item.collectStatus}}</text>
        </view>
      </view>

      <view class="record-card__body">
        <view class="record-detail">
          <view class="record-detail__row">
            <text class="record-detail__label">水费</text>
            <text class="record-detail__value">{{item.waterUsageText}} · {{item.waterFeeText}}</text>
          </view>
          <view class="record-detail__row">
            <text class="record-detail__label">电费</text>
            <text class="record-detail__value">{{item.elecUsageText}} · {{item.elecFeeText}}</text>
          </view>
          <view class="record-detail__row">
            <text class="record-detail__label">房租</text>
            <text class="record-detail__value">{{item.rentText}}</text>
          </view>
          <view class="record-detail__row record-detail__row--total">
            <text class="record-detail__label">合计</text>
            <text class="record-detail__value record-detail__value--total">{{item.totalText}}</text>
          </view>
          <view class="record-detail__row" wx:if="{{item.remark}}">
            <text class="record-detail__label">备注</text>
            <text class="record-detail__value">{{item.remark}}</text>
          </view>
        </view>
      </view>

      <view class="record-card__actions">
        <view class="mini-btn mini-btn--pdf" data-id="{{item.id}}" bindtap="onGenPdf" wx:if="{{isAdmin || permState.receipt_pdf}}">PDF</view>
        <view class="mini-btn" data-id="{{item.id}}" bindtap="editRecord" wx:if="{{isAdmin || permState.ledger_edit}}">编辑</view>
        <view class="mini-btn mini-btn--danger" data-id="{{item.id}}" bindtap="deleteRecord" wx:if="{{isAdmin || permState.ledger_delete}}">删除</view>
      </view>
    </view>
  </view>

  <!-- ===== 抄表录入 ===== -->
  <view class="tab-content" wx:if="{{currentTab === 'meter'}}">
    <view class="form-card">
      <view class="form-card__title">{{editingId ? '编辑记录' : '新增抄表记录'}}</view>

      <!-- 房号（picker 优先历史房号，可手输） -->
      <view class="form-row">
        <text class="form-label">房号</text>
        <input class="form-input" type="text" placeholder="如 A101" value="{{meterForm.room}}" data-field="room" bindinput="onMeterInput" />
      </view>

      <view class="form-row">
        <text class="form-label">月份</text>
        <input class="form-input" type="text" placeholder="如 2026-08" value="{{meterForm.month}}" data-field="month" bindinput="onMeterInput" />
      </view>

      <view class="form-divider">水表</view>
      <view class="form-row form-row--double">
        <view class="form-cell">
          <text class="form-label">上次读数</text>
          <input class="form-input" type="digit" placeholder="0" value="{{meterForm.prevWater}}" data-field="prevWater" bindinput="onMeterInput" />
        </view>
        <view class="form-cell">
          <text class="form-label">本次读数</text>
          <input class="form-input" type="digit" placeholder="0" value="{{meterForm.currWater}}" data-field="currWater" bindinput="onMeterInput" />
        </view>
      </view>

      <view class="form-divider">电表</view>
      <view class="form-row form-row--double">
        <view class="form-cell">
          <text class="form-label">上次读数</text>
          <input class="form-input" type="digit" placeholder="0" value="{{meterForm.prevElec}}" data-field="prevElec" bindinput="onMeterInput" />
        </view>
        <view class="form-cell">
          <text class="form-label">本次读数</text>
          <input class="form-input" type="digit" placeholder="0" value="{{meterForm.currElec}}" data-field="currElec" bindinput="onMeterInput" />
        </view>
      </view>

      <view class="form-divider">费用</view>
      <view class="form-row">
        <text class="form-label">房租 ($)</text>
        <input class="form-input" type="digit" placeholder="0" value="{{meterForm.rent}}" data-field="rent" bindinput="onMeterInput" />
      </view>

      <view class="form-row">
        <text class="form-label">备注</text>
        <input class="form-input" type="text" placeholder="选填" value="{{meterForm.remark}}" data-field="remark" bindinput="onMeterInput" />
      </view>

      <!-- 实时计算结果 -->
      <view class="calc-preview">
        <view class="calc-preview__row">
          <text>水用量</text>
          <text>{{meterCalc.waterUsage}} 吨</text>
        </view>
        <view class="calc-preview__row">
          <text>电用量</text>
          <text>{{meterCalc.elecUsage}} 度</text>
        </view>
        <view class="calc-preview__row">
          <text>水费</text>
          <text>${{meterCalc.waterFee}}</text>
        </view>
        <view class="calc-preview__row">
          <text>电费</text>
          <text>${{meterCalc.elecFee}}</text>
        </view>
        <view class="calc-preview__row calc-preview__row--total">
          <text>合计</text>
          <text>${{meterCalc.total}}</text>
        </view>
      </view>

      <view class="form-actions">
        <button class="form-btn form-btn--primary" bindtap="saveMeterRecord" wx:if="{{isAdmin || permState.meter}}">{{editingId ? '保存修改' : '保存记录'}}</button>
        <button class="form-btn form-btn--ghost" bindtap="resetMeterForm" wx:if="{{editingId}}">取消编辑</button>
      </view>
    </view>

    <!-- 费率设置 -->
    <view class="form-card">
      <view class="form-card__title">费率设置</view>
      <view class="form-row form-row--double">
        <view class="form-cell">
          <text class="form-label">水费率 ($/吨)</text>
          <input class="form-input" type="digit" placeholder="0.7" value="{{rates.water}}" data-field="water" bindinput="onRateInput" />
        </view>
        <view class="form-cell">
          <text class="form-label">电费率 ($/度)</text>
          <input class="form-input" type="digit" placeholder="0.205" value="{{rates.elec}}" data-field="elec" bindinput="onRateInput" />
        </view>
      </view>
      <button class="form-btn form-btn--ghost" bindtap="saveRates" wx:if="{{isAdmin || permState.rate_setting}}">保存费率</button>
    </view>
  </view>

  <!-- ===== 用户管理 ===== -->
  <view class="tab-content" wx:if="{{currentTab === 'users' && isAdmin}}">
    <view class="user-card" wx:for="{{users}}" wx:key="id">
      <view class="user-card__left">
        <view class="user-card__avatar {{item.role === 'admin' ? 'admin' : 'operator'}}">{{item.avatarChar}}</view>
        <view class="user-card__info">
          <text class="user-card__name">{{item.username}}</text>
          <text class="user-card__role role-badge role-badge--{{item.role === 'admin' ? 'admin' : 'operator'}}">{{item.role === 'admin' ? '管理员' : '操作员'}}</text>
          <text class="user-card__created">{{item.createdAt}}</text>
        </view>
      </view>
      <view class="user-card__actions" wx:if="{{isAdmin || permState.user_manage}}">
        <view class="mini-btn" data-id="{{item.id}}" bindtap="openUserModal">编辑</view>
        <view class="mini-btn mini-btn--danger" data-id="{{item.id}}" bindtap="deleteUser" wx:if="{{item.username !== 'admin'}}">删除</view>
      </view>
    </view>

    <view class="add-user-btn" bindtap="openUserModal">+ 新增操作员</view>
  </view>

  <!-- 客服咨询 -->
  <contact-bar text="物业系统咨询" />
</view>

<!-- ===== 用户编辑弹窗 ===== -->
<view class="modal-mask" wx:if="{{userModalShown}}" bindtap="closeUserModal">
  <view class="modal-card" catchtap="">
    <view class="modal-card__title">{{userModalTitle}}</view>

    <view class="form-row">
      <text class="form-label">用户名</text>
      <input class="form-input" type="text" placeholder="请输入用户名" value="{{userForm.username}}" data-field="username" bindinput="onUserInput" />
    </view>
    <view class="form-row">
      <text class="form-label">密码</text>
      <input class="form-input" type="text" password="{{true}}" placeholder="请输入密码" value="{{userForm.password}}" data-field="password" bindinput="onUserInput" />
    </view>
    <view class="form-row">
      <text class="form-label">角色</text>
      <picker value="{{userForm.role === 'admin' ? 0 : 1}}" range="{{['管理员', '操作员']}}" bindchange="onUserRoleChange">
        <view class="form-input form-input--picker">
          <text>{{userForm.role === 'admin' ? '管理员' : '操作员'}}</text>
          <text class="filter-arrow">▾</text>
        </view>
      </picker>
    </view>

    <!-- 权限选择（仅操作员可定制，管理员默认全权限） -->
    <view class="form-row" wx:if="{{userForm.role !== 'admin'}}">
      <text class="form-label">权限分配</text>
      <view class="perm-grid">
        <view class="perm-item {{userPermMap[item.key] ? 'perm-item--active' : ''}}" wx:for="{{permissionDefs}}" wx:key="key" data-key="{{item.key}}" bindtap="toggleUserPermission">
          <view class="perm-item__check">{{userPermMap[item.key] ? '☑' : '☐'}}</view>
          <view class="perm-item__body">
            <text class="perm-item__label">{{item.label}}</text>
            <text class="perm-item__desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="form-actions">
      <button class="form-btn form-btn--primary" bindtap="saveUser">保存</button>
      <button class="form-btn form-btn--ghost" bindtap="closeUserModal">取消</button>
    </view>
  </view>
</view>
