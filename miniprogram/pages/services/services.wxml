<!-- pages/services/services.wxml -->
<!-- 供应商/服务网络：接后端 /api/providers，按类目分组 + 入驻 -->

<view class="container">
  <view class="svc-header">
    <view class="svc-header__title">{{L.title}}</view>
    <view class="svc-header__lang" bindtap="onLangSwitch">{{languageLabel}}</view>
  </view>

  <view class="svc-list">
    <block wx:for="{{groups}}" wx:key="kind" wx:for-item="g">
      <view class="svc-group__title">{{g.label}}</view>
      <view class="svc-card" wx:for="{{g.list}}" wx:key="id" wx:for-item="p">
        <view class="svc-card__name">{{p.name}}</view>
        <view class="svc-card__sub">{{p.city}} · ★{{p.rating}}</view>
        <view class="svc-tags">
          <text class="svc-tag" wx:for="{{p.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        </view>
        <view class="svc-card__meta">
          <text>{{L.priceLabel}}: {{p.price_info}}</text>
          <text>{{L.contactLabel}}: {{p.contact}}</text>
        </view>
        <view class="svc-card__desc">{{p.desc}}</view>
        <button
          class="req-btn req-btn--outline"
          data-type="{{p.kind}}"
          data-title="{{p.name}}"
          data-detail="{{p.city}} · {{p.tags}}"
          bindtap="createRequirement"
        >{{L.consultBtn}}</button>
      </view>
    </block>
    <view wx:if="{{groups.length === 0}}" class="svc-empty">…</view>
  </view>

  <view class="svc-bottom">
    <button class="req-btn req-btn--primary" bindtap="toggleApply">{{L.applyBtn}}</button>
  </view>

  <!-- 入驻表单弹层 -->
  <view wx:if="{{showApply}}" class="mask" bindtap="toggleApply">
    <view class="apply-sheet" catchtap="noop">
      <view class="apply-title">{{L.applyTitle}}</view>
      <input class="field" placeholder="{{L.formName}}" value="{{applyForm.name_zh}}" data-f="name_zh" bindinput="onApplyInput" />
      <picker class="picker" range="{{L.kindOptions}}" bindchange="onKindChange">
        <view class="picker-val">{{L.kindOptions[kindIndex]}}</view>
      </picker>
      <input class="field" placeholder="{{L.formCity}}" value="{{applyForm.city}}" data-f="city" bindinput="onApplyInput" />
      <input class="field" placeholder="{{L.formTags}}" value="{{applyForm.tags}}" data-f="tags" bindinput="onApplyInput" />
      <input class="field" placeholder="{{L.formPrice}}" value="{{applyForm.price_info}}" data-f="price_info" bindinput="onApplyInput" />
      <input class="field" placeholder="{{L.formContact}}" value="{{applyForm.contact}}" data-f="contact" bindinput="onApplyInput" />
      <textarea class="field area" placeholder="{{L.formDesc}}" value="{{applyForm.desc_zh}}" data-f="desc_zh" bindinput="onApplyInput" />
      <button class="req-btn req-btn--primary" bindtap="submitApply">{{L.applyTitle}}</button>
      <button class="req-btn req-btn--outline" bindtap="toggleApply">取消</button>
    </view>
  </view>
</view>
