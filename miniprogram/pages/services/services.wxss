.container { padding: 16px; }
.svc-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
.svc-header__title { font-size: 18px; font-weight: 600; color: #B8860B; }
.svc-header__lang { padding: 4px 10px; background: #f0f0f0; border-radius: 14px; font-size: 12px; }

.svc-group__title { font-size: 14px; font-weight: 600; margin: 14px 0 8px; color: #333; border-left: 3px solid #B8860B; padding-left: 8px; }

.svc-card { background: #fff; border-radius: 10px; padding: 12px; margin-bottom: 10px; box-shadow: 0 1px 3px rgba(0,0,0,.06); }
.svc-card__name { font-size: 15px; font-weight: 600; }
.svc-card__sub { font-size: 12px; color: #888; margin: 2px 0 6px; }
.svc-tags { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 6px; }
.svc-tag { background: #f7f0dd; color: #B8860B; border-radius: 4px; padding: 1px 6px; font-size: 11px; }
.svc-card__meta { display: flex; flex-direction: column; font-size: 12px; color: #666; margin-bottom: 4px; line-height: 1.6; }
.svc-card__desc { font-size: 12px; color: #999; margin-bottom: 8px; }

.req-btn { border-radius: 8px; font-size: 13px; margin-top: 6px; }
.req-btn--outline { background: #fff; color: #B8860B; border: 1px solid #B8860B; }
.req-btn--primary { background: #B8860B; color: #fff; }

.svc-bottom { margin-top: 16px; margin-bottom: 24px; }
.svc-empty { text-align: center; color: #999; padding: 30px; }

.mask { position: fixed; inset: 0; background: rgba(0,0,0,.4); display: flex; align-items: flex-end; z-index: 100; }
.apply-sheet { background: #fff; width: 100%; padding: 20px; border-radius: 16px 16px 0 0; box-sizing: border-box; }
.apply-title { font-size: 16px; font-weight: 600; margin-bottom: 12px; text-align: center; }
.field { border: 1px solid #ddd; border-radius: 8px; padding: 10px; margin-bottom: 10px; font-size: 14px; width: 100%; box-sizing: border-box; }
.area { height: 70px; }
.picker { border: 1px solid #ddd; border-radius: 8px; padding: 10px; margin-bottom: 10px; }
.picker-val { font-size: 14px; }
