.container { padding: 16px; }
.svc-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
.svc-header__title { font-size: 18px; font-weight: 600; color: var(--text-primary); }
.svc-header__lang { padding: 4px 10px; background: var(--bg-secondary); border-radius: 14px; font-size: 12px; color: var(--text-secondary); }

.svc-group__title { font-size: 14px; font-weight: 600; margin: 14px 0 8px; color: var(--text-primary); border-left: 3px solid var(--gold); padding-left: 8px; }

.svc-card { background: #fff; border-radius: 10px; padding: 12px; margin-bottom: 10px; box-shadow: 0 1px 3px rgba(0,0,0,.06); }
.svc-card__name { font-size: 15px; font-weight: 600; }
.svc-card__sub { font-size: 12px; color: #888; margin: 2px 0 6px; }
.svc-tags { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 6px; }
.svc-tag { background: var(--bg-secondary); color: var(--gold); border-radius: 4px; padding: 1px 6px; font-size: 11px; }
.svc-card__meta { display: flex; flex-direction: column; font-size: 12px; color: var(--text-secondary); margin-bottom: 4px; line-height: 1.6; }
.svc-card__desc { font-size: 12px; color: var(--text-hint); margin-bottom: 8px; }

.req-btn { border-radius: 8px; font-size: 13px; margin-top: 6px; }
.req-btn--outline { background: #fff; color: var(--gold); border: 1px solid var(--gold); }
.req-btn--primary { background: var(--gold); color: #fff; }

.svc-bottom { margin-top: 16px; margin-bottom: 24px; }
.svc-empty { text-align: center; color: #999; padding: 30px; }

.mask { position: fixed; inset: 0; background: rgba(0,0,0,.4); display: flex; align-items: flex-end; z-index: 100; }
.apply-sheet { background: #fff; width: 100%; max-height: 82vh; overflow-y: auto; padding: 20px 20px calc(20px + env(safe-area-inset-bottom)); border-radius: 16px 16px 0 0; box-sizing: border-box; }
.apply-title { font-size: 16px; font-weight: 600; margin-bottom: 16px; text-align: center; }
.field { border: 1px solid #ddd; border-radius: 8px; padding: 12px 14px; margin-bottom: 12px; font-size: 14px; line-height: 1.5; width: 100%; box-sizing: border-box; background: #fff; min-height: 44px; }
.area { min-height: 100px; height: 100px; }
.picker { border: 1px solid #ddd; border-radius: 8px; padding: 0 14px; margin-bottom: 12px; min-height: 44px; display: flex; align-items: center; box-sizing: border-box; }
.picker-val { font-size: 14px; color: #333; }
.apply-sheet .req-btn { margin-bottom: 8px; }
.apply-sheet .req-btn:last-of-type { margin-bottom: 0; }
